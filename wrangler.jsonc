{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wildfire",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "wildfire.hubn.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    { "name": "APPLY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "APPLICATIONS_CLOSED": "0",
    "TERMS_VERSION": "2026-10-22",
    "RESUME_MAX_MB": "5",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "野火申请 <wildfire@forms.hubn.com>"
  },
  "observability": { "enabled": false }
}
