---
import Layout from '../../layouts/Layout.astro';
import { publishedProjects, initiators, roleNames } from '../../lib/content.mjs';
export function getStaticPaths() {
  return publishedProjects().filter((project) => project.hasDetailPage).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const initiator = initiators.find((item) => item.slug === project.initiator);
const applyUrl = project.acceptingApplications ? `/apply?project=${project.slug}` : '/apply';
---
<Layout title={`${project.name} · 野火项目详情`} description={`${project.name}：${project.oneLiner} 野火共创项目，面向在校大学生与想转行的人，由发起人亲自带。`}>
  <section class="detail-hero"><div class="container stack gap-24">
    <a class="text-link back-link" href="/#projects">← 全部项目</a>
    <div class="detail-name"><h1>{project.name}</h1><span class:list={['status', { 'status-live': project.status === '已上线' }]}>{project.status}</span></div>
    <p class="secondary detail-tagline measure-copy">{project.oneLiner}</p>
    {project.mode === 'company' && <p class="company-note">这个项目以实习或招聘的方式开启，遵循项目方公司的规则。</p>}
    <div class="button-row">{project.externalUrl && <a class="button button-outline" href={project.externalUrl} target="_blank" rel="noopener noreferrer">体验产品</a>}<a class="button" href={applyUrl}>申请加入</a></div>
    <dl class="detail-facts">
      <div><dt>状态</dt><dd>{project.status}</dd></div><div><dt>需要的岗位</dt><dd>{project.roles.map(({ role }) => roleNames[role]).join('、')}</dd></div><div><dt>盈利可能</dt><dd>{project.profitPotential}</dd></div><div><dt>合作条件</dt><dd>{project.collaboration}</dd></div>
      <div><dt>发起人</dt><dd>{<a class="text-link" href={`/initiators/${initiator.slug}`}>{initiator.name}</a>}</dd></div>
    </dl>
  </div></section>
  <section class="panel detail-section"><div class="container two-column"><div class="stack"><div class="eyebrow">这个项目是什么</div>{project.about.map((text) => <p class="body-large secondary">{text}</p>)}</div><div class="stack"><div class="eyebrow">现在到哪了</div>{project.progress.map((text) => <p class="body-large secondary">{text}</p>)}</div></div></section>
  <section class="detail-section"><div class="container stack gap-32"><div class="stack gap-14 measure"><div class="eyebrow">需要什么样的人</div>{project.rolesHeading && <h2 class="detail-h2">{project.rolesHeading}</h2>}</div><div class="role-grid">{project.roles.map((role) => <div class="role-card stack gap-12"><h3>{roleNames[role.role]}</h3>{role.description.split(/\n\n/).map((paragraph) => <p class="note muted">{paragraph}</p>)}</div>)}</div></div></section>
  {initiator && <section class="detail-section"><div class="container initiator-strip"><div class="stack gap-8"><div class="eyebrow muted">发起人</div><div class="initiator-strip-name">{initiator.name}</div><p class="note muted">{initiator.oneLiner}</p></div><a class="button button-outline" href={`/initiators/${initiator.slug}`}>了解发起人 →</a></div></section>}
  <section class="light detail-section"><div class="container stack gap-20"><h2>想做{project.name}？</h2><a class="button" href={applyUrl}>申请加入</a></div></section>
</Layout>
