---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description, home = false, noindex = false, canonical } = Astro.props;
const applicationsClosed = process.env.WILDFIRE_APPLICATIONS_CLOSED === '1';

const siteOrigin = Astro.site ? Astro.site.origin : 'https://wildfire.hubn.com';
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = canonical ?? (pathname === '/' ? `${siteOrigin}/` : `${siteOrigin}${pathname}`);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="野火 Wildfire" />
    <meta property="og:type" content={home ? 'website' : 'article'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
  </head>
  <body><Header home={home} />{applicationsClosed && <div class="closed-notice" role="status">申请暂未开放。</div>}<main><slot /></main><Footer /></body>
</html>
