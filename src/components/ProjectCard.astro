---
import { initiators, roleNames } from '../lib/content.mjs';
const { project } = Astro.props;
const initiator = initiators.find((item) => item.slug === project.initiator);
---
<article class="project-card" data-project={project.slug}>
  <div class="card-heading">
    <h3>{project.name}</h3>
    <span class:list={['status', { 'status-live': project.status === '已上线' }]}>{project.status}</span>
  </div>
  <p class="body-large secondary">{project.oneLiner}</p>
  {project.hasDetailPage && <a class="text-link project-link" href={`/projects/${project.slug}`}>查看项目详情 →</a>}
  <dl class="card-facts">
    <dt>需要</dt><dd>{project.roles.map(({ role }) => roleNames[role]).join('、')}</dd>
    <dt>盈利可能</dt><dd>{project.profitPotential}</dd>
    <dt>合作条件</dt><dd>{project.collaboration}</dd>
    <dt>发起人</dt><dd>{<a class="text-link" href={`/initiators/${initiator.slug}`}>{initiator.name}</a>}</dd>
  </dl>
</article>
